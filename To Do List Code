user_input = 'WHat's Up'

data = []

def show_menu():
    print('Menu: ')
    print('1 is Add an Item')
    print('2 is Mark as Done')
    print('3 is View Items')
    print('4 is exit')

while user_input != '4':
    show_menu()
    user_input = input('Enter Your Choice: ')

    if user_input == '1':
        item = input('What is to be done? ')
        data.append(item)
        print('Added item: ' , item)
    elif user_input == '2':
        item = input('What is to be marked as completed? ')
        if item in data:
            data.remove(item)
            print('Removed item: ', item)
        else:
            print('Item does not exist in the list")
    elif user_input == '3':
        print('List of to-do items: ')
        for item in data:
            print(item)
    elif user_input == '4':
        print("Goodbye')
    else:
        print('Please enter one of 1, 2, 3, or 4')
